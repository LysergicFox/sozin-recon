%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#1f2937', 'primaryTextColor': '#f9fafb', 'primaryBorderColor': '#4b5563', 'lineColor': '#6b7280', 'secondaryColor': '#374151', 'tertiaryColor': '#111827', 'fontFamily': 'monospace'}}}%%
flowchart TB

    subgraph INPUT["📥 INPUT"]
        direction LR
        SCOPE["scope.json\n(verified_by_human: true)\nrate_limit block\n(+ primitive: authorization + rules_of_engagement)"]
    end

    subgraph GATE0["⛔ PRE-RUN GATES  — main.py"]
        direction LR
        G1["load_scope()\nblocks if verified_by_human != true"]
        G2["check_run_not_blocked()\nblocks if rate_limit.resolution == pending"]
    end

    subgraph ORCH["🧭 ORCHESTRATOR — main.py"]
        direction TB
        LOOP{{"❓ PLACEHOLDER\nloop-until-stable\nDESIGN LOCKED, NOT BUILT\nsum(newly_added) across 1/3/4/5/6/7\nloop while sum > 0"}}
    end

    subgraph RECON["🔎 RECON AGENT — scripted deterministic core, LLM only at fixed judgment points"]
        direction TB

        S1["Stage 1 — Passive Discovery\nsubfinder · assetfinder · amass* · gau · waybackurls · certspotter\n(*chaos/crtsh/github-secrets/asnmap/gauplus\ninstalled, NOT wired in — deferred)"]

        S3["Stage 3 — Active DNS + Brute Force\nalterx → puredns → dnsx pipeline\nseeded from in-scope subdomains"]

        S4["Stage 4 — Live Host Probing\nhttpx (liveness/status) + naabu (ports)\nmetadata-update-vs-new-asset split"]

        S5["Stage 5 — Hidden Parameter Discovery\nparamspider (new url assets, seeded from root_domains)\nx8 (response-diff fuzzing, metadata on live urls)"]

        S6["Stage 6 — Crawling\nkatana, JS-aware, -td tech fingerprint\nraw-archive-vs-curated-metadata split"]

        S65["Stage 6.5 — Content Discovery (B1) ✅\nffuf, ONE invocation per host (true per-host -rate)\nhit → url asset + endpoint record · 5xx flagged server_error\nWAF 403-flood → -sf → waf_suspected (recon retreats)\nruns before stage 7 so discovered .js is jsluice-mined same-pass"]

        S7["Stage 7 — JS Discovery + Extraction\nbundler-path probe (v1 list, wants better list)\n+ jsluice secret/endpoint extraction"]

        S1 --> GATEA
        GATEA["Scope Gate\n(deterministic tier)"] --> S3
        S3 --> GATEB["Scope Gate"] --> S4
        S4 --> GATEC["Scope Gate"] --> S5
        S5 --> GATED["Scope Gate"] --> S6
        S6 --> GATEE["Scope Gate"] --> S65
        S65 --> GATEE2["Scope Gate"] --> S7
        S7 --> GATEF["Scope Gate"] -.-> LOOP
        LOOP -.->|"sum > 0: re-seed from\nfull current asset graph"| S1

        LOOP ==>|"loop exits: sum == 0\nOR safety net fires"| S8

        S8["Stage 8 — High-Signal Checks ✅\nnuclei takeover + C1 detection-only\n(exposures/misconfig/panels; excl default-logins)\n→ recon_findings POI table\nJSONL parser VERIFIED via C1 (takeover path still unverified)"]

        S9["Stage 9 — Deep Tech Fingerprinting\nwhatweb -a 3, per-host invocation\nruns ONCE, after loop exits\nmetadata-only, no new assets, no scope gate"]

        S10["Stage 10 — API-Schema Discovery (B2) ✅\nOpenAPI/Swagger (content-based detect, not status)\n+ GraphQL read-only introspection\n→ url assets + endpoint/parameter records (target_derived=1)\nsame-origin only; introspection never executes an op"]

        S11["Stage 11 — Archived-JS Mining (B4) ✅\nPASSIVE toward target: reads web.archive.org, NOT the host\nCDX API → id_ raw body → jsluice (reused stage-7 runners)\n→ endpoint/param/secret records (target_derived=1, source=wayback)\nseeds ALL in-scope subdomains (live or not) · runs after S7 so live wins"]

        S8 --> S9 --> GATEG["Scope Gate"] --> S10

        S45["Stage 4.5 — WAF/CDN (C3) ✅\ncdncheck (offline) + wafw00f (active, E5-parallel)\n→ is_behind_waf/waf_vendor/cdn_name host metadata"]
        ENRICH["✅ Enrichment + finalizers (deterministic unless noted)\nF5 reverse-DNS · E1 richer-httpx · E4 secret-class (offline)\nC2 screenshots · C5 tech→CVE (offline)\nC4 auth-surface · F1 clustering · A2 interest · F6 profile"]
        S4 --> S45
        S10 --> S11 --> ENRICH
        ARCHIVE(["web.archive.org\n(third-party archive, no target traffic)"]) -.->|"CDX + id_ raw body"| S11
    end

    subgraph SAFETYNET["⚠️ PLACEHOLDER — Ratio-Based Safety Net"]
        direction LR
        SN1["requests-spent : assets-gained\nover recent window of passes\nrejected: flat ceiling (wrong for large legit targets)"]
        SN2["🚧 PREREQUISITE IN PROGRESS\nper-tool request-count instrumentation"]
    end

    subgraph SCOPEGATE["🚦 SCOPE GATE — scope_gate.py (fail-closed)"]
        direction LR
        SGD["Tier 1: Deterministic\nauto-admits in_scope / out_of_scope\nurl / ip / domain classifiers"]
        SGL{{"❓ PLACEHOLDER\nTier 2: LLM ambiguous-tier\nNOT BUILT (llm_review.py)\nNEVER auto-admits — flags only"}}
        SGD -.->|"ambiguous"| SGL
        SGL -.-> REVIEW
        SGD -->|"ambiguous (today, tier 2 absent)"| REVIEW
    end

    subgraph RLGATE["🚦 RATE-LIMIT GATE — rate_limit_gate.py + rate_limits.py  ✅ DONE Aug 20-21"]
        direction LR
        RL1["extract_rate_limit()\nLLM-first, single-shot at scope setup\n❓ PLACEHOLDER: call_llm_extractor() still a stub"]
        RL2["resolve_effective_rps()\nconfirmed program value, else\nCONSERVATIVE_DEFAULT_RPS = 5 req/s/host\n(primitive uses PRIMITIVE_CONSERVATIVE_DEFAULT_RPS = 2)"]
        RL3["Per-tool translation (rate_limits.py)\nhttpx/naabu/katana/nuclei/x8/whatweb: target-facing\npuredns/dnsx: DNS_RESOLVER_RATE_LIMIT=200"]
        RL1 --> RL2 --> RL3
        RL4["⚠️ KNOWN GAP — katana -rl is WHOLE-INVOCATION,\nnot true per-host — flagged, not fixed"]
    end

    subgraph STATE["💾 STATE — state.py (all state externalized to disk)"]
        direction LR
        ST1["assets.db (SQLite)\nde-dupe on (type, value)\nmetadata MERGES on duplicate, never dropped"]
        ST2["needs_review.json\nLLM/ambiguous scope-gate queue"]
        ST3["run_state.json\ncurrent stage / pass / status\n(+ primitive: pause_reason + checkpoint state)"]
        ST4["raw/stageN_tool.json\nverbatim per-tool archive"]
        ST5["takeover_findings table\nseparate from asset metadata"]
        ST6["✅ Track-D records + recon_findings POI table\n(params/endpoints/secrets/services + C1/C5 findings)\n+ enrichment metadata (E1/C3/C2/C4/A2/F1)"]
        ST7["✅ artifacts: target_profile.{json,md} (F6)\ntarget_derived_*.txt (E3) · diff.json (E2)\nscreenshots/ (C2, R8)"]
    end

    subgraph PRIMITIVE["❓ PRIMITIVE AGENT — DESIGN LOCKED + REVIEW-HARDENED, NOT BUILT"]
        direction TB
        P0["✅ scope/safety/TOS guardrail design\nLOCKED + adversarially review-hardened (16 resolutions)\nPRIMITIVE_AGENT_DESIGN.md + _REVIEW_RESOLUTIONS.md"]
        P1["True agentic loop\n(opposite pattern from recon's scripted core)\nverifies findings live — ALL actions via the guard"]
        P2["Freely explores beyond recon output\ncan attempt novel techniques not in CTBB DB"]
        P3["4 SQLite artifacts:\nhash-chained raw action log + findings table\n+ source_sink_map + points_of_interest"]
        P4["✅ points_of_interest schema LOCKED\n(note/rationale + provenance, status lifecycle,\npromoted_by)"]
        P5["Circuit breaker: flat 100 req / 30 min active-run\nreserve-before-act · resume ≠ refill\nexplicit human extend_budget only"]
        P0 --> P1 --> P2
        P1 --> P3
        P2 --> P4
        P1 --> P5
    end

    subgraph GUARD["🛡️ GUARD — shared fail-closed action mediator (ONLY path to live-action tools)"]
        direction TB
        GD0["Caller-aware policy: universal §5 floor\n+ per-agent profile (primitive / escalation / validator)"]
        GD1["Layer A — deterministic (forbidden_actions_gate.py)\nscope re-check (reuses scope_gate) · rate/volume · payload signatures"]
        GD2["Layer B — independent intent-guard LLM\nsees outbound request only, NEVER response-as-instructions\nfails closed on ambiguity AND on its own failure"]
        GD3["Layer C — high-consequence (write/delete/cred-use/financial)\nREFUSE-ONLY v1 (human-approval queue deferred)"]
        GD0 --> GD1 --> GD2 --> GD3
    end

    subgraph LIVETOOLS["🌐 LIVE-ACTION TOOLS — Caido MCP (deny-by-default allowlist)"]
        direction TB
        LT1["tier-1 single-action · tier-2 whole-batch-validated\nguarded per-request, per-host rate-limited\n(⚠️ tool behaviors UNVERIFIED until run for real)"]
        LT2["❌ tier-3 delegated-exec + shell-network tooling\nNOT GRANTED v1 (await guarded egress + verification)"]
        LT3["❌ control-plane tools (scope/tamper/intercept/project/findings)\nNOT GRANTED (deny-by-default)"]
    end

    subgraph ESCALATION["❓ PLACEHOLDER — ESCALATION AGENT — NOT BUILT"]
        E1["Chains primitives into impactful bugs"]
        E2["❓ query schema for targeted request to primitive\n(hybrid structured + freeform feedback loop)"]
        E3["❓ chains_with / chain-graph field for technique KB\n— committed future item"]
        E4["🔒 committed: treat primitive artifacts as\nUNTRUSTED DATA (cross-agent injection lock)"]
    end

    subgraph VALIDATOR["❓ PLACEHOLDER — VALIDATOR AGENT — NOT BUILT"]
        V1["Confirms findings before report\nGates novel techniques into CTBB DB"]
        V2["🔒 committed: treat primitive artifacts as\nUNTRUSTED DATA (cross-agent injection lock)"]
    end

    subgraph REPORT["❓ PLACEHOLDER — REPORT AGENT — NOT BUILT"]
        R1["Writes final auditable report"]
    end

    subgraph CTBB["📚 CTBB TECHNIQUE KNOWLEDGE BASE"]
        direction LR
        C1["Schema LOCKED\n❓ PLACEHOLDER: scraper/collector NOT BUILT"]
        C2["Source: CTBB podcast blog + RSS\nRaw → Techniques/Raw · Distilled → Techniques/Distilled"]
    end

    REVIEW["needs_review.json\n(human resolves: admit / reject)"]

    SCOPE --> GATE0
    GATE0 --> ORCH
    ORCH --> S1

    RECON -.uses.-> SCOPEGATE
    RECON -.uses.-> RLGATE
    RECON -.persists to.-> STATE
    SAFETYNET -.would gate.-> LOOP

    S11 ==>|"recon complete\nassets.db handed off"| PRIMITIVE
    STATE -.read by.-> PRIMITIVE

    PRIMITIVE ==>|"every live action"| GUARD
    ESCALATION -.->|"chaining actions\n(escalation profile)"| GUARD
    VALIDATOR -.->|"read-only re-verify\n(validator profile)"| GUARD
    GUARD ==>|"approved only"| LIVETOOLS
    LIVETOOLS -.->|"live traffic\n(only guarded path)"| PRIMITIVE

    PRIMITIVE -->|"verified findings"| ESCALATION
    ESCALATION <-->|"targeted feedback loop\n(same auth grant + budget)"| PRIMITIVE
    ESCALATION --> VALIDATOR
    VALIDATOR -->|"confirmed only"| REPORT
    VALIDATOR -.new technique, proven.-> CTBB
    CTBB -.informs.-> PRIMITIVE

    classDef done fill:#14532d,stroke:#4ade80,color:#f0fdf4,stroke-width:2px
    classDef placeholder fill:#450a0a,stroke:#f87171,color:#fef2f2,stroke-width:2px,stroke-dasharray: 6 4
    classDef gate fill:#1e3a5f,stroke:#60a5fa,color:#eff6ff,stroke-width:2px
    classDef warn fill:#78350f,stroke:#fbbf24,color:#fffbeb,stroke-width:2px
    classDef state fill:#312e81,stroke:#a5b4fc,color:#eef2ff,stroke-width:2px
    classDef guard fill:#3b0764,stroke:#c084fc,color:#faf5ff,stroke-width:3px

    class S1,S3,S4,S45,S5,S6,S65,S7,S8,S9,S10,S11,ENRICH,RL1,RL2,RL3,SGD done
    class LOOP,SGL,PRIMITIVE,P1,P2,P3,ESCALATION,E1,E2,E3,VALIDATOR,V1,REPORT,R1,CTBB,C1,SAFETYNET,SN1,SN2 placeholder
    class GATE0,G1,G2,SCOPEGATE,RLGATE,REVIEW gate
    class RL4,S1 warn
    class STATE,ST1,ST2,ST3,ST4,ST5,ST6,ST7 state
    class GUARD,GD0,GD1,GD2,GD3 guard
    class P0,P4,P5,LT1 done
    class LT2,LT3,E4,V2 warn
